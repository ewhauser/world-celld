{
  "name": "workflow-world-queue-consumer",
  "main": "worker.ts",
  "compatibility_date": "2026-01-01",
  "services": [
    { "binding": "WORLD_SERVICE", "service": "workflow-world", "entrypoint": "QueueDeliveryRpc" },
  ],
  "queues": {
    "producers": [{ "binding": "WORKFLOW_QUEUE", "queue": "workflow-world" }],
    "consumers": [
      {
        "queue": "workflow-world",
        "max_batch_size": 10,
        // Dispatch as soon as a message is ready. Every workflow step hop
        // goes through this queue, so a batch-fill wait adds to each hop.
        "max_batch_timeout": 0,
        "max_retries": 100,
        "dead_letter_queue": "workflow-world-dlq",
        "max_concurrency": 25,
      },
    ],
  },
  "vars": {
    // REQUIRED. Inject the same value used by the primary worker through
    // vars in a private deployment copy of this config; never commit secrets.
    "WORLD_SECRET": "",
  },
}
